ROUTER_URL=http://127.0.0.1:20128/v1
ROUTER_KEY=sk-xxxx
# Daftar model dipisah koma: model pertama utama, sisanya fallback otomatis
ROUTER_MODEL=ag/gemini-3.8-flash-low,ag/gemini-3.7-flash-low
TTS_VOICE=id-ID-ArdiNeural
# Engine TTS: 'clone' (suara sendiri via FireRedTTS3 dengan auto-fallback) atau 'edge' (Edge TTS saja)
TTS_ENGINE=clone
CLONE_URL=http://127.0.0.1:8000/tts
CLONE_TIMEOUT_MS=12000
PORT=3000
